# frozen_string_literal: true

require "rake/testtask"
require "rbconfig"
require_relative "../test/support/mutations"

Rake::TestTask.new(:test) do |task|
  task.libs << "test"
  task.test_files = FileList["test/**/*_test.rb"]
  task.warning = true
end

# A control with no mutation test behind it is a comment. On this side of the boundary the controls are about
# classification and about what a caller may choose, where every failure is silent.
MUTATIONS = {
  "analyzer_swallows_transient" => "image_analyzer_test.rb",
  "previewer_probes_for_binaries" => "previewers_test.rb",
  "library_keywords_pass_through" => "transformations_test.rb",
  "read_write_descriptors" => "transformer_test.rb",
}.freeze

desc "Break each control in turn and confirm the suite notices"
task :mutations do
  survivors = MUTATIONS.reject do |mutation, suite|
    output = `#{RbConfig.ruby} -Ilib -Itest -rmutations/#{mutation} test/#{suite} 2>&1`
    status, summary = Mutations.result(output)
    puts format("  %-30s %-26s %-9s %s", mutation, suite, status.to_s, summary)
    status == :caught
  end

  abort "not caught: #{survivors.keys.join(", ")}" if survivors.any?
end

task default: :test
