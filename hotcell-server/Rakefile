# frozen_string_literal: true

require "rake/testtask"
require "rbconfig"

Rake::TestTask.new(:test) do |task|
  task.libs << "test"
  task.test_files = FileList["test/**/*_test.rb"]
  task.warning = true
end

# A control with no mutation test behind it is a comment. Each entry breaks one control and names the suite
# that has to notice. haystack#8538 did this by editing production code by hand; doing it with a monkey
# patch means the source is never touched and nothing can be left mutated by accident.
MUTATIONS = {
  "no_rlimits" => "resource_limits_test.rb",
  "no_clamp" => "scheduling_test.rb",
  "no_deadline_report" => "scheduling_test.rb",
  "no_death_report" => "scheduling_test.rb",
  "lazy_reap" => "scheduling_test.rb",
  "never_retire" => "scheduling_test.rb",
  "wide_open_descriptors" => "cell_test.rb",
  "no_scratch_removal" => "cell_test.rb",
}.freeze

desc "Break each control in turn and confirm the suite notices"
task :mutations do
  survivors = MUTATIONS.reject do |mutation, suite|
    output = `#{RbConfig.ruby} -Ilib -Itest -rmutations/#{mutation} test/#{suite} 2>&1`
    caught = !output.include?("0 failures, 0 errors")
    puts format("  %-24s %-26s %s", mutation, suite, caught ? "caught" : "SURVIVED")
    caught
  end

  abort "the suite does not hold: #{survivors.keys.join(", ")}" if survivors.any?
end

task default: :test
