# frozen_string_literal: true

# The cell's Gemfile. Only the two gems that run in a cell — hotcell-client and activesupport are not here,
# and hotcell-server depends on neither on purpose.
#
# Copy-on-write cost scales with the supervisor's resident heap: a 58MB parent costs a forked worker about
# 8,900 minor faults on its first request, and a 265MB parent costs 25,900 and about 52ms more. Every gem
# loaded here is paid for on every request, forever, so this list staying short is a performance property as
# well as a security one.

source "https://rubygems.org"

gemspec path: "hotcell-core",   name: "hotcell-core"
gemspec path: "hotcell-server", name: "hotcell-server"

# A derived image drops its operations, and whatever they need, into /hotcell/operations.
operations = "/hotcell/operations/Gemfile"
eval_gemfile operations if File.exist?(operations)
