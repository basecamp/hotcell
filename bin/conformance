#!/usr/bin/env bash
# Does this image actually support hotcell? Boots IMAGE as a cell with the accessory's real flags —
# network: none, cap-drop ALL, a read-only root, a noexec tmpfs — with the example operations mounted and
# HOTCELL_DIR pointed somewhere non-default, then drives the shared battery from a second container over
# a named volume. The socket appearing where HOTCELL_DIR said proves the env contract; the descriptor
# crossing between the two containers is part of every check; the isolation checks prove the flags held.
#
# Exits non-zero on the first failed check, so a user or CI can gate on it.
#
#   bin/conformance IMAGE [DRIVER_IMAGE]
#
# The driver is a stock Ruby image rather than the image under test, so a minimal cell image never needs
# to carry the client's dependencies. Installing those in the driver is the one step that needs network.
set -euo pipefail

IMAGE="${1:?usage: bin/conformance IMAGE [DRIVER_IMAGE]}"
DRIVER_IMAGE="${2:-ruby:3.4}"
REPO="$(cd "$(dirname "$0")/.." && pwd)"
STAMP="$$"
CELL="hotcell-conformance-cell-$STAMP"
VOLUME="hotcell-conformance-$STAMP"
DIRECTORY="/run/hotcell/cell/conformance"

cleanup() {
  docker rm -f "$CELL" >/dev/null 2>&1 || true
  docker volume rm "$VOLUME" >/dev/null 2>&1 || true
}
trap cleanup EXIT

# A named volume inherits the ownership of the image's directory, which is why the base image creates
# /run/hotcell owned by the cell's user. A bind mount would keep the host directory's ownership, and the
# cell then could not create its own socket. See docs/DEPLOYMENT.md.
docker volume create "$VOLUME" >/dev/null

echo "booting $IMAGE with the accessory's flags, HOTCELL_DIR=$DIRECTORY"
docker run --detach --name "$CELL" \
  --network none \
  --read-only \
  --tmpfs /tmp:rw,nosuid,nodev,noexec,size=512m \
  --memory 2g --memory-swap 2g \
  --cpus 2 \
  --pids-limit 512 \
  --cap-drop ALL \
  --security-opt no-new-privileges:true \
  --user 10001:10001 \
  --ulimit stack=2097152:2097152 \
  --env HOTCELL_DIR="$DIRECTORY" \
  --env HOTCELL_OPERATIONS=/hotcell/operations \
  --volume "$REPO/examples/operations:/hotcell/operations:ro" \
  --volume "$VOLUME:/run/hotcell/cell" \
  "$IMAGE" >/dev/null

# The driver runs as its own uid and joins the cell's group, which is the deployment the docs describe. As
# root it would bypass the sockets' 0660 and prove nothing about the group that is meant to be carrying
# the access control.
echo "driving the battery from a second container over the shared volume"
if ! docker run --rm \
  --user 2000:2000 \
  --group-add 10001 \
  --volume "$REPO:/repo:ro" \
  --volume "$VOLUME:/run/hotcell/cell" \
  --env HOME=/tmp/driver \
  --env HOTCELL_DIR="$DIRECTORY" \
  --env HOTCELL_GROUP=10001 \
  --env HOTCELL_REPO=/repo \
  --env BUNDLE_GEMFILE=/tmp/driver/Gemfile \
  --env BUNDLE_PATH=/tmp/driver/bundle \
  "$DRIVER_IMAGE" bash -c "
    install -D /repo/examples/Gemfile /tmp/driver/Gemfile &&
    bundle install --quiet &&
    bundle exec ruby /repo/examples/conformance
  "
then
  echo "FAIL. Cell log:"
  docker logs "$CELL" 2>&1 | sed 's/^/  /'
  exit 1
fi

echo
echo "cell log:"
docker logs "$CELL" 2>&1 | sed 's/^/  /'
echo "PASS: $IMAGE supports hotcell"
