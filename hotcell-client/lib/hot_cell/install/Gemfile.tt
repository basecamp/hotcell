# frozen_string_literal: true

# The cell's Gemfile. Keep it short: every gem loaded here is inside the blast radius and paid for on
# every request. hotcell-client and rails do not belong here.

source "https://rubygems.org"

# TODO: pin to released gems once hotcell is published
git "https://github.com/basecamp/hotcell.git", branch: "master" do
  gem "hotcell-core",   glob: "hotcell-core/*.gemspec"
  gem "hotcell-server", glob: "hotcell-server/*.gemspec"
end

# Gems your operations need go here. For example:
#
# gem "image_processing"
# gem "ruby-vips"
